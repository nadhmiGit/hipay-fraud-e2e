{
  "name": "playwright-bdd-template",
  "version": "1.0.0",
  "description": "A clean Playwright BDD testing template with Gherkin/Cucumber support and TypeScript",
  "license": "MIT",
  "scripts": {
    "gen:tests": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:headless": "bddgen && playwright test",
    "test:ui": "run-p watch:*",
    "test:debug": "bddgen && playwright test --debug",
    "test:chromium": "bddgen && playwright test --project=chromium",
    "test:firefox": "bddgen && playwright test --project=firefox",
    "test:webkit": "bddgen && playwright test --project=webkit",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test --grep @regression",
    "report": "playwright show-report",
    "report:cucumber": "allure generate ./allure-results -o ./allure-report/ --clean",
    "watch:bdd": "nodemon -w ./features -w ./steps -e feature,js,ts --exec \"npx bddgen\"",
    "watch:pw": "playwright test --ui"
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "bdd",
    "cucumber",
    "gherkin",
    "testing",
    "e2e",
    "automation",
    "typescript"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.3.2",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "playwright-bdd": "^8.4.2",
    "prettier": "^3.6.2",
    "prettier-plugin-gherkin": "^3.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
